<?xml version="1.0" encoding="UTF-8"?>
<language id="nim" name="Nim" version="2.0" _section="Source">
  <metadata>
    <property name="mimetypes">text/x-nim</property>
    <property name="globs">*.nim;*.nims;*.nimble</property>
    <property name="line-comment-start">#</property>
  </metadata>

  <styles>
    <style id="comment" name="Comment" map-to="def:comment"/>
    <style id="string" name="String" map-to="def:string"/>
    <style id="keyword" name="Keyword" map-to="def:keyword"/>
    <style id="boolean" name="Boolean" map-to="def:boolean"/>
    <style id="number" name="Number" map-to="def:number"/>
    <style id="type" name="Type" map-to="def:type"/>
    <style id="pragma" name="Pragma" map-to="def:preprocessor"/>
    <style id="operator" name="Operator" map-to="def:operator"/>
  </styles>

  <definitions>
    <context id="line-comment" style-ref="comment" class="comment" end-at-line-end="true">
      <start>#(?!\[)</start>
    </context>

    <context id="block-comment" style-ref="comment" class="comment">
      <start>#\[</start>
      <end>]#</end>
      <include>
        <context ref="block-comment"/>
      </include>
    </context>

    <context id="triple-string" style-ref="string" class="string">
      <start>"""</start>
      <end>"""</end>
    </context>

    <context id="raw-string" style-ref="string" class="string">
      <start>r"</start>
      <end>"</end>
    </context>

    <context id="string" style-ref="string" class="string" end-at-line-end="true">
      <start>"</start>
      <end>"</end>
      <include>
        <context id="string-escape" style-ref="number">
          <match>\\.</match>
        </context>
      </include>
    </context>

    <context id="char-literal" style-ref="string" class="string" end-at-line-end="true">
      <start>'</start>
      <end>'</end>
    </context>

    <context id="pragma" style-ref="pragma" class="preprocessor">
      <start>\{</start>
      <end>}</end>
    </context>

    <context id="number" style-ref="number" class="number">
      <match extended="true">
        \b(?:
          0[xX][0-9A-Fa-f][0-9A-Fa-f_]* |
          0[oO][0-7][0-7_]* |
          0[bB][01][01_]* |
          [0-9][0-9_]*(?:\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?
        )\b
      </match>
    </context>

    <context id="boolean" style-ref="boolean" class="boolean">
      <keyword>true</keyword>
      <keyword>false</keyword>
    </context>

    <context id="keyword" style-ref="keyword" class="keyword">
      <keyword>addr</keyword>
      <keyword>and</keyword>
      <keyword>as</keyword>
      <keyword>asm</keyword>
      <keyword>bind</keyword>
      <keyword>block</keyword>
      <keyword>break</keyword>
      <keyword>case</keyword>
      <keyword>cast</keyword>
      <keyword>concept</keyword>
      <keyword>const</keyword>
      <keyword>continue</keyword>
      <keyword>converter</keyword>
      <keyword>defer</keyword>
      <keyword>discard</keyword>
      <keyword>distinct</keyword>
      <keyword>div</keyword>
      <keyword>do</keyword>
      <keyword>elif</keyword>
      <keyword>else</keyword>
      <keyword>end</keyword>
      <keyword>enum</keyword>
      <keyword>except</keyword>
      <keyword>export</keyword>
      <keyword>finally</keyword>
      <keyword>for</keyword>
      <keyword>from</keyword>
      <keyword>func</keyword>
      <keyword>if</keyword>
      <keyword>import</keyword>
      <keyword>in</keyword>
      <keyword>include</keyword>
      <keyword>interface</keyword>
      <keyword>is</keyword>
      <keyword>isnot</keyword>
      <keyword>iterator</keyword>
      <keyword>let</keyword>
      <keyword>macro</keyword>
      <keyword>method</keyword>
      <keyword>mixin</keyword>
      <keyword>mod</keyword>
      <keyword>nil</keyword>
      <keyword>not</keyword>
      <keyword>notin</keyword>
      <keyword>object</keyword>
      <keyword>of</keyword>
      <keyword>or</keyword>
      <keyword>out</keyword>
      <keyword>proc</keyword>
      <keyword>ptr</keyword>
      <keyword>raise</keyword>
      <keyword>ref</keyword>
      <keyword>return</keyword>
      <keyword>shl</keyword>
      <keyword>shr</keyword>
      <keyword>static</keyword>
      <keyword>template</keyword>
      <keyword>try</keyword>
      <keyword>tuple</keyword>
      <keyword>type</keyword>
      <keyword>using</keyword>
      <keyword>var</keyword>
      <keyword>when</keyword>
      <keyword>while</keyword>
      <keyword>xor</keyword>
      <keyword>yield</keyword>
    </context>

    <context id="builtin-type" style-ref="type" class="type">
      <keyword>any</keyword>
      <keyword>array</keyword>
      <keyword>auto</keyword>
      <keyword>bool</keyword>
      <keyword>byte</keyword>
      <keyword>char</keyword>
      <keyword>cchar</keyword>
      <keyword>cdouble</keyword>
      <keyword>cfloat</keyword>
      <keyword>cint</keyword>
      <keyword>clong</keyword>
      <keyword>clongdouble</keyword>
      <keyword>clonglong</keyword>
      <keyword>cschar</keyword>
      <keyword>cshort</keyword>
      <keyword>csize</keyword>
      <keyword>csize_t</keyword>
      <keyword>cstring</keyword>
      <keyword>cstringArray</keyword>
      <keyword>cuchar</keyword>
      <keyword>cuint</keyword>
      <keyword>culong</keyword>
      <keyword>culonglong</keyword>
      <keyword>cushort</keyword>
      <keyword>float</keyword>
      <keyword>float32</keyword>
      <keyword>float64</keyword>
      <keyword>int</keyword>
      <keyword>int8</keyword>
      <keyword>int16</keyword>
      <keyword>int32</keyword>
      <keyword>int64</keyword>
      <keyword>iterable</keyword>
      <keyword>lent</keyword>
      <keyword>Natural</keyword>
      <keyword>openArray</keyword>
      <keyword>pointer</keyword>
      <keyword>Positive</keyword>
      <keyword>range</keyword>
      <keyword>Rune</keyword>
      <keyword>seq</keyword>
      <keyword>set</keyword>
      <keyword>sink</keyword>
      <keyword>string</keyword>
      <keyword>typed</keyword>
      <keyword>typedesc</keyword>
      <keyword>uint</keyword>
      <keyword>uint8</keyword>
      <keyword>uint16</keyword>
      <keyword>uint32</keyword>
      <keyword>uint64</keyword>
      <keyword>untyped</keyword>
      <keyword>void</keyword>
    </context>

    <!-- Nim type names start with a capital. The style was declared and unused. -->
    <context id="type-name" style-ref="type" class="type">
      <match>\b[A-Z][A-Za-z0-9_]*\b</match>
    </context>

    <context id="operator" style-ref="operator" class="operator">
      <match>(?:==|!=|&lt;=|&gt;=|\+=|-=|\*=|/=|:=|-&gt;|=&gt;|\.\.|[&lt;&gt;+\-*/])</match>
    </context>

    <context id="nim" class="no-spell-check">
      <include>
        <context ref="line-comment"/>
        <context ref="block-comment"/>
        <context ref="triple-string"/>
        <context ref="raw-string"/>
        <context ref="string"/>
        <context ref="char-literal"/>
        <context ref="pragma"/>
        <context ref="number"/>
        <context ref="boolean"/>
        <context ref="keyword"/>
        <context ref="builtin-type"/>
        <context ref="type-name"/>
        <context ref="operator"/>
      </include>
    </context>
  </definitions>
</language>
